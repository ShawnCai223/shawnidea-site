---
const pathname = Astro.url.pathname;
const isHome     = pathname === '/';
const isProjects = pathname.startsWith('/projects');
const isBlog     = pathname.startsWith('/blog');
const isAbout    = pathname.startsWith('/about');
const isContact  = pathname.startsWith('/contact');
---

<header class="site-nav">
  <div class="nav-pill" role="navigation" aria-label="Primary">
    <a class="nav-brand" href="/">
      <span class="brand-dot"></span>
      <span>shawnidea</span>
    </a>
    <span class="nav-divider"></span>
    <nav class="nav-links">
      <a href="/"         class:list={[{ 'is-active': isHome }]}>Home</a>
      <a href="/projects" class:list={[{ 'is-active': isProjects }]}>Projects</a>
      <a href="/blog"     class:list={[{ 'is-active': isBlog }]}>Notes</a>
      <a href="/about"    class:list={[{ 'is-active': isAbout }]}>About</a>
      <a href="/contact"  class:list={[{ 'is-active': isContact }]}>Say hi</a>
    </nav>
    <span class="nav-divider"></span>
    <button class="nav-theme-btn" id="theme-btn" aria-label="Toggle dark mode" title="Toggle theme">
      <span class="icon-sun">☀︎</span>
      <span class="icon-moon">☾</span>
    </button>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-btn');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('si-theme', next);
  });
</script>
