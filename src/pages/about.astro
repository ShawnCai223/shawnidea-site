---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const education = [
  {
    school: 'University of California, San Diego',
    location: 'San Diego, CA',
    degree: 'B.S.',
    major: 'Computer Science',
    time: '2019 – 2023',
    gpa: '',
  },
];

const skills = [
  { group: 'Languages',       list: ['Go', 'Python', 'Java', 'SQL', 'Bash', 'TypeScript'] },
  { group: 'Frameworks',      list: ['FastAPI', 'Gin', 'gRPC', 'Spring Boot', 'Astro'] },
  { group: 'Databases',       list: ['PostgreSQL', 'Redis', 'Elasticsearch', 'MongoDB'] },
  { group: 'Infrastructure',  list: ['Docker', 'Kubernetes', 'AWS', 'Terraform', 'Prometheus'] },
];

const experience = [
  {
    company: 'Company Name',
    location: 'San Francisco, CA',
    role: 'Software Engineer',
    time: '2023 – Present',
    details: [
      'Designed and built backend services with reliability and observability in mind.',
      'Led migrations and performance tuning across APIs, queues, and storage layers.',
    ],
  },
  {
    company: 'Previous Company',
    location: 'Remote',
    role: 'Software Engineer Intern',
    time: '2022',
    details: [
      'Built internal tooling and real-time data pipelines.',
      'Improved latency and developer workflows through targeted systems work.',
    ],
  },
];
---

<html lang="en">
  <head>
    <BaseHead title="About — Shawn Cai" description="Professional background, skills, and experience." />
  </head>
  <body>
    <Header />

    <div class="resume-page">
      <!-- Page hero -->
      <section class="page-hero">
        <div class="container">
          <span class="eyebrow">Career</span>
          <h1>About</h1>
          <p style="font-size:1.05rem; margin-top:1rem; max-width:55ch; color:var(--ink-3);">
            Engineer who enjoys building systems and exploring ideas.
          </p>
        </div>
      </section>

      <!-- Profile -->
      <div class="resume-main-shell">
        <section class="resume-profile">
          <div>
            <div class="resume-profile-photo resume-profile-photo--placeholder">SC</div>
          </div>
          <div class="resume-profile-copy">
            <h2 class="resume-profile-name">Shawn Cai</h2>
            <p class="resume-profile-location">San Diego, CA</p>
            <div class="resume-profile-text">
              <p>Backend engineer focused on distributed systems, clean APIs, and developer tooling. I care about correctness, clarity, and shipping things that last.</p>
            </div>
            <div class="resume-profile-actions">
              <a href="/resume.pdf" class="btn btn-primary" download>Download PDF</a>
            </div>
          </div>
        </section>

        <!-- Education -->
        <section class="resume-section">
          <div class="resume-section-rail">
            <h2>Education</h2>
          </div>
          <div class="resume-education-list">
            {education.map(ed => (
              <article class="resume-education-item">
                <div class="resume-education-row">
                  <div class="resume-education-school">{ed.school}</div>
                  <div class="resume-education-location">{ed.location}</div>
                </div>
                <div class="resume-education-row">
                  <div class="resume-education-meta">
                    {[ed.degree, ed.major, ed.gpa].filter(Boolean).join('  ·  ')}
                  </div>
                  <div class="resume-education-date">{ed.time}</div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- Skills -->
        <section class="resume-section">
          <div class="resume-section-rail">
            <h2>Skills</h2>
          </div>
          <div class="resume-skills-stack">
            {skills.map(g => (
              <div class="resume-skills-group">
                <div class="resume-skills-title">{g.group}</div>
                <div class="resume-skills-tags">
                  {g.list.map(s => <span class="resume-skills-tag">{s}</span>)}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- Experience -->
        <section class="resume-section" style="border-bottom:none;">
          <div class="resume-section-rail">
            <h2>Experience</h2>
          </div>
          <div class="resume-experience-list">
            {experience.map(exp => (
              <article class="resume-experience-item">
                <div class="resume-experience-line">
                  <div class="resume-experience-company">{exp.company}</div>
                  <div class="resume-experience-location">{exp.location}</div>
                </div>
                <div class="resume-experience-line">
                  <div class="resume-experience-role">{exp.role}</div>
                  <div class="resume-experience-date">{exp.time}</div>
                </div>
                {exp.details.length > 0 && (
                  <ul class="resume-experience-points">
                    {exp.details.map(d => <li>{d}</li>)}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </section>
      </div>
    </div>

    <Footer />
  </body>
</html>
