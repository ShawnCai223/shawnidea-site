---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="About — Shawn Cai" description="Engineer & maker based in San Diego." />
  </head>
  <body>
    <Header />

    <div class="page">
      <div class="container">
        <div class="page-hero">
          <span class="eyebrow accent">About · the short version</span>
          <h1>Shawn Cai.</h1>
          <p class="lead">
            Engineer & maker based in San Diego. The short version below.
            <a href="/contact" style="color: var(--accent); text-decoration: underline; text-underline-offset: 3px;">Reach out</a>
            for the long one.
          </p>
        </div>

        <div class="cv-layout">

          <!-- Sticky rail -->
          <aside class="cv-rail">
            <div class="cv-rail-photo">
              <span class="photo-mark">SC</span>
            </div>
            <div>
              <div class="cv-rail-name">Shawn Cai</div>
              <div class="cv-rail-loc">San Diego, CA</div>
            </div>

            <div class="cv-rail-group">
              <span class="eyebrow">Contact</span>
              <div class="cv-rail-links">
                <a href="/contact">Email <span class="arr">›</span></a>
                <a href="https://github.com/ShawnCai223" target="_blank" rel="noopener">GitHub <span class="arr">↗</span></a>
                <a href="https://linkedin.com/in/shawncai" target="_blank" rel="noopener">LinkedIn <span class="arr">↗</span></a>
              </div>
            </div>

            <div class="cv-rail-group">
              <span class="eyebrow">Languages</span>
              <div class="chips">
                <span class="chip">Python</span>
                <span class="chip">TypeScript</span>
                <span class="chip">JavaScript</span>
                <span class="chip">SQL</span>
                <span class="chip">Shell</span>
              </div>
            </div>

            <div class="cv-rail-group">
              <span class="eyebrow">Stack</span>
              <div class="chips">
                <span class="chip">Flask</span>
                <span class="chip">Astro</span>
                <span class="chip">PostgreSQL</span>
                <span class="chip">AWS</span>
                <span class="chip">Cloudflare</span>
                <span class="chip">OpenAI API</span>
              </div>
            </div>

            <a class="btn ghost" href="/resume.pdf" download style="justify-content:center;">↓ Download PDF</a>
          </aside>

          <!-- Main column -->
          <div class="cv-main">

            <div class="cv-block">
              <div class="cv-block-head">
                <h2>Experience</h2>
              </div>
              <div class="cv-cards-stack">
                <div class="cv-card">
                  <div class="cv-card-row">
                    <span class="cv-card-title">[Company]</span>
                    <span class="cv-card-loc">San Diego, CA</span>
                  </div>
                  <div class="cv-card-row">
                    <span class="cv-card-role">[Your role here]</span>
                    <span class="cv-card-meta">2024 — Present</span>
                  </div>
                  <ul class="cv-card-points">
                    <li>Replace this with one bullet describing what you owned.</li>
                    <li>Replace this with one bullet describing impact (numbers help).</li>
                    <li>Replace this with one bullet about a system or product you shipped.</li>
                  </ul>
                </div>
                <div class="cv-card">
                  <div class="cv-card-row">
                    <span class="cv-card-title">[Company]</span>
                    <span class="cv-card-loc">Remote</span>
                  </div>
                  <div class="cv-card-row">
                    <span class="cv-card-role">[Previous role]</span>
                    <span class="cv-card-meta">2023 — 2024</span>
                  </div>
                  <ul class="cv-card-points">
                    <li>Short summary of responsibilities and outcomes.</li>
                    <li>Tools used, scale of system, what changed because of you.</li>
                  </ul>
                </div>
              </div>
            </div>

            <div class="cv-block">
              <div class="cv-block-head">
                <h2>Education</h2>
              </div>
              <div class="cv-cards-stack">
                <div class="cv-card">
                  <div class="cv-card-row">
                    <span class="cv-card-title">UC San Diego</span>
                    <span class="cv-card-loc">La Jolla, CA</span>
                  </div>
                  <div class="cv-card-row">
                    <span class="cv-card-role">MS, Computer Science</span>
                    <span class="cv-card-meta">2024 — 2026</span>
                  </div>
                </div>
                <div class="cv-card">
                  <div class="cv-card-row">
                    <span class="cv-card-title">Tongji University</span>
                    <span class="cv-card-loc">Shanghai, China</span>
                  </div>
                  <div class="cv-card-row">
                    <span class="cv-card-role">BS, Software Engineering</span>
                    <span class="cv-card-meta">2019 — 2023</span>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>
