---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

// Assign a thumb style per post (cycle through options)
const thumbStyles = ['t-orange', '', 't-dark', ''];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Notes — Shawn Cai" description="Some thoughts about building, traveling, and being." />
  </head>
  <body>
    <Header />

    <div class="page">
      <div class="container">
        <div class="page-hero">
          <span class="eyebrow accent">Notes · journal</span>
          <h1>Notes.</h1>
          <p class="lead">Some thoughts about building, traveling, and being.</p>
        </div>

        <div class="blog-list">
          {posts.map((post, i) => (
            <a class="blog-row" href={`/blog/${post.id}/`}>
              <span class="blog-row-date">{formatDate(post.data.pubDate)}</span>
              <div class="blog-row-body">
                <div class="blog-row-title">{post.data.title}</div>
                {post.data.description && (
                  <div class="blog-row-excerpt">{post.data.description}</div>
                )}
              </div>
              <div class={`blog-row-thumb ${thumbStyles[i % thumbStyles.length]}`}></div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>
