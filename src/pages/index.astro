---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const projects = [
  {
    title: 'AI Blog Generator',
    date: 'Jul 2025',
    tags: ['OpenAI API', 'JavaScript'],
    link: '/projects/ai-blog-generator',
    thumb: '/projects/ai-blog.jpg',
  },
];

const posts = [
  {
    title: 'Getting your hands dirty vs. hitting the books first.',
    date: 'Mar 20, 2026',
    slug: 'getting-your-hands-dirty',
  },
  {
    title: 'Hi, this is shawnidea.com',
    date: 'Mar 14, 2026',
    slug: 'hi-this-is-shawnidea',
  },
];
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --bg: #f5f0eb;
        --bg-offset: #ede8e2;
        --rule: #d8d0c8;
        --ink: #1a1a1a;
        --ink-4: #888;
        --accent: #c0533a;
        --font-sans: 'Georgia', serif;
        --font-mono: 'Courier New', monospace;
      }
      body { background: var(--bg); color: var(--ink); font-family: var(--font-sans); }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
      section { padding: 5rem 0; }
      .eyebrow { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; color: var(--accent); text-transform: uppercase; display: block; margin-bottom: 0.75rem; }
      .section-heading { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin-bottom: 1rem; }
      .section-lead { color: var(--ink-4); margin-bottom: 2.5rem; }
      .btn { display: inline-block; padding: 0.6rem 1.4rem; border-radius: 4px; text-decoration: none; font-size: 0.9rem; cursor: pointer; }
      .btn-primary { background: var(--accent); color: white; }

      /* Hero */
      .hero { position: relative; overflow: hidden; padding: 6rem 0; }
      .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(var(--rule) 1px,transparent 1px), linear-gradient(90deg,var(--rule) 1px,transparent 1px); background-size: 64px 64px; opacity: 0.5; }
      .hero-shell { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; position: relative; z-index: 1; }
      .hero-name { font-size: clamp(3rem, 6vw, 5rem); font-style: italic; line-height: 1; margin-bottom: 1rem; }
      .hero-role { color: var(--ink-4); line-height: 1.6; }
      .hero-name-native { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-4); display: block; margin-bottom: 0.5rem; }
      .code-titlebar { background: #2d2d2d; border-radius: 8px 8px 0 0; padding: 0.5rem 1rem; display: flex; align-items: center; gap: 6px; }
      .code-titlebar span:nth-child(1) { width:12px; height:12px; border-radius:50%; background:#ff5f57; }
      .code-titlebar span:nth-child(2) { width:12px; height:12px; border-radius:50%; background:#ffbd2e; }
      .code-titlebar span:nth-child(3) { width:12px; height:12px; border-radius:50%; background:#28c840; }
      .code-filename { margin-left: auto; font-family: var(--font-mono); font-size: 0.75rem; color: #888; }
      .code-body { background: #1e1e1e; padding: 1.5rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.7; color: #d4d4d4; }
      .code-body .kw { color: #569cd6; }
      .code-body .fn { color: #dcdcaa; }
      .code-body .str { color: #ce9178; }
      .code-body .cm { color: #6a9955; }
      .code-statusbar { background: #007acc; padding: 0.25rem 1rem; border-radius: 0 0 8px 8px; font-family: var(--font-mono); font-size: 0.7rem; color: white; display: flex; gap: 1rem; }

      /* About */
      .about-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; align-items: center; }
      .about-photo { width: 100%; border-radius: 8px; aspect-ratio: 1; object-fit: cover; background: var(--rule); display: flex; align-items: center; justify-content: center; font-size: 4rem; }

      /* Projects */
      .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
      .project-card { background: white; border-radius: 8px; overflow: hidden; text-decoration: none; color: inherit; border: 1px solid var(--rule); display: block; }
      .project-thumb { height: 160px; background: var(--rule); overflow: hidden; }
      .project-thumb img { width: 100%; height: 100%; object-fit: cover; }
      .project-body { padding: 1.25rem; }
      .project-date { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-4); font-weight: bold; display: block; margin-bottom: 0.5rem; }
      .project-title { font-size: 1.1rem; margin-bottom: 0.75rem; }
      .project-stack-line { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 0.75rem; }
      .project-stack-item { background: var(--bg-offset); border: 1px solid var(--rule); border-radius: 20px; padding: 2px 10px; font-size: 0.75rem; font-family: var(--font-mono); }
      .project-link { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); }

      /* Blog */
      .post-row { display: flex; justify-content: space-between; align-items: baseline; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
      .post-row h3 { font-size: 1rem; font-weight: normal; }
      .post-date { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-4); white-space: nowrap; margin-left: 2rem; }
      .post-list a { text-decoration: none; color: inherit; }
      .post-list a:hover h3 { color: var(--accent); }

      @media (max-width: 768px) {
        .hero-shell { grid-template-columns: 1fr; }
        .about-layout { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <Header />

    <!-- HERO -->
    <section class="hero">
      <div class="hero-grid"></div>
      <div class="container">
        <div class="hero-shell">
          <div class="hero-content">
            <span class="hero-name-native">蔡俊达</span>
            <h1 class="hero-name">Shawn Cai</h1>
            <p class="hero-role">
              <strong>Backend Engineer</strong> & Algorithm Enthusiast<br>
              Projects, ideas, and moments from life.
            </p>
          </div>
          <div class="hero-aside">
            <div class="code-titlebar">
              <span></span><span></span><span></span>
              <span class="code-filename">main.go</span>
            </div>
            <div class="code-body" set:html={`<pre><span class="kw">func</span> <span class="fn">Describe</span>(name <span class="kw">string</span>) map[string]interface{} {
  <span class="kw">return</span> map[string]interface{}{
    <span class="str">"name"</span>: name,
    <span class="str">"role"</span>: <span class="str">"engineer"</span>,
    <span class="str">"likes"</span>: []string{<span class="str">"clean code"</span>, <span class="str">"simple systems"</span>},
    <span class="str">"currently"</span>: <span class="str">"building, and writing"</span>,
  }
}

<span class="kw">var</span> me = <span class="fn">Describe</span>(<span class="str">"Shawn Cai"</span>)</pre>`}>
</div>
            <div class="code-statusbar">
              <span>Go</span><span>INSERT</span><span>main.go</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section style="background:var(--bg-offset); border-top:1px solid var(--rule);">
      <div class="container">
        <div class="about-layout">
          <div class="about-photo-wrap">
            <div class="about-photo">👤</div>
          </div>
          <div class="about-body">
            <span class="eyebrow">About</span>
            <h2 class="section-heading">I build things with code.<br>And write about life along the way.</h2>
            <p style="color:var(--ink-4); line-height:1.8;">Engineer by profession, curious by nature.<br>Here I share projects, thoughts, and small moments from life.</p>
            <div style="margin-top:2rem;">
              <a href="/resume" class="btn btn-primary">View Resume</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section>
      <div class="container">
        <span class="eyebrow">Building</span>
        <h2 class="section-heading">Featured Projects</h2>
        <p class="section-lead">A selection of things I've built.</p>
        <div class="projects-grid">
          {projects.map(p => (
            <a href={p.link} class="project-card">
              <div class="project-thumb"></div>
              <div class="project-body">
                <span class="project-date">{p.date}</span>
                <h3 class="project-title">{p.title}</h3>
                <div class="project-stack-line">
                  {p.tags.map(t => <span class="project-stack-item">{t}</span>)}
                </div>
                <div><span class="project-link">→ Details</span></div>
              </div>
            </a>
          ))}
        </div>
        <div style="margin-top:2.5rem; text-align:center;">
          <a href="/projects" class="btn btn-primary">All Projects</a>
        </div>
      </div>
    </section>

    <!-- BLOG -->
    <section style="background:var(--bg-offset); border-top:1px solid var(--rule);">
      <div class="container">
        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:1.5rem;">
          <div>
            <span class="eyebrow">Writing</span>
            <h2 class="section-heading" style="margin-bottom:0;">Latest Blog</h2>
          </div>
          <a href="/blog" class="btn btn-primary">All blogs</a>
        </div>
        <div class="post-list">
          {posts.map(p => (
            <a href={`/blog/${p.slug}`}>
              <div class="post-row">
                <h3>{p.title}</h3>
                <span class="post-date">{p.date}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section>
      <div class="container" style="text-align:center;">
        <span class="eyebrow" style="display:block; text-align:center;">Let's work together</span>
        <h2 class="section-heading" style="margin:0 auto 1rem;">Got an interesting problem?</h2>
        <p class="section-lead" style="margin:0 auto 2.5rem; text-align:center;">
          I'm open to full-time roles, contract work, and good conversations about hard engineering.
        </p>
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
      </div>
    </section>

    <Footer />
  </body>
</html>