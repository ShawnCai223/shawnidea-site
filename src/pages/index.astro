---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <div class="page">

      <!-- Hero -->
      <div class="container">
        <div class="home-hero">
          <span class="home-hero-eyebrow">
            <span class="pulse"></span>San Diego, CA · building, writing, exploring
          </span>
          <h1>Hi, I'm Shawn<span class="accent-mark">.</span></h1>
          <p class="lead">
            Engineer & maker building small, careful tools. I write here.
          </p>
          <div class="home-cta-row">
            <a class="btn ghost cta-equal" href="/about">About me</a>
            <a class="btn ghost cta-equal" href="/contact">Say hi</a>
          </div>
        </div>
      </div>

      <!-- Featured projects -->
      <div class="container">
        <div class="home-section">
          <div class="home-section-head">
            <h2 class="home-section-title">Featured projects</h2>
            <a class="home-section-more" href="/projects">All work <span>›</span></a>
          </div>
          <div class="home-featured-grid">
            {projects.map((project, i) => {
              const glyph = project.data.glyph ?? project.data.title.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase();
              const year = project.data.pubDate.getFullYear();
              const langs = project.data.languages ?? [];
              const stack = project.data.stack ?? [];
              const chips = [...langs, ...stack].slice(0, 3);
              return (
                <a class="home-feature-card" href={`/projects/${project.id}/`}>
                  <div class={`home-feature-thumb${i === 0 ? ' tinted' : ''}`}>
                    <span class="thumb-mark">Project · {year}</span>
                    <span class="thumb-glyph">{glyph}</span>
                  </div>
                  <h3>{project.data.title}</h3>
                  <p>{project.data.description}</p>
                  <div class="home-feature-meta">
                    {chips.map((chip: string, j: number) => (
                      <span class={`chip${j === 0 ? ' accent' : ''}`}>{chip}</span>
                    ))}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Recent notes -->
      <div class="container">
        <div class="home-section">
          <div class="home-section-head">
            <h2 class="home-section-title">Recent notes</h2>
            <a class="home-section-more" href="/blog">All writing <span>›</span></a>
          </div>
          <div class="home-posts">
            {posts.map(post => (
              <a href={`/blog/${post.id}/`}>
                <span class="post-date">{formatDate(post.data.pubDate)}</span>
                <span class="post-title">{post.data.title}</span>
                <span class="post-arrow">›</span>
              </a>
            ))}
          </div>
        </div>
      </div>

    </div>

    <Footer />
  </body>
</html>
