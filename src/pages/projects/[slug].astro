---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
const { title, description, pubDate, languages, stack, github, demo, role, glyph: glyphData } = project.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const year = pubDate.getFullYear();

const glyph = glyphData ?? title.split(' ')[0].slice(0, 2).toUpperCase();
---

<html lang="en">
  <head>
    <BaseHead title={`${title} — Shawn Cai`} description={description} />
  </head>
  <body>
    <Header />

    <div class="page">
      <div class="container">

        <div class="pd-hero">
          <a class="pd-back" href="/projects">‹ Back to work</a>
          <span class="eyebrow accent">Project · {formatDate(pubDate)}</span>
          <h1>{title}.</h1>
          <p class="lead">{description}</p>
          <div class="pd-hero-image">
            <span class="hero-glyph">{glyph}</span>
          </div>
        </div>

        <div class="pd-layout">
          <article class="pd-body">
            <Content />
          </article>

          <aside class="pd-meta">
            <div class="pd-meta-group">
              <span class="eyebrow">Year</span>
              <span class="pd-meta-value">{year}</span>
            </div>
            {role && (
              <div class="pd-meta-group">
                <span class="eyebrow">Role</span>
                <span class="pd-meta-value">{role}</span>
              </div>
            )}
            {languages.length > 0 && (
              <div class="pd-meta-group">
                <span class="eyebrow">Languages</span>
                <div class="chips">
                  {languages.map((l: string) => (
                    <span class="chip accent">{l}</span>
                  ))}
                </div>
              </div>
            )}
            {stack.length > 0 && (
              <div class="pd-meta-group">
                <span class="eyebrow">Stack</span>
                <div class="chips">
                  {stack.map((s: string) => (
                    <span class="chip">{s}</span>
                  ))}
                </div>
              </div>
            )}
            {(github || demo) && (
              <div class="pd-meta-group">
                <span class="eyebrow">Links</span>
                <div class="pd-meta-links">
                  {github && (
                    <a class="pd-meta-link" href={github} target="_blank" rel="noopener">
                      <span class="icon-svg" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.92.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.43-2.69 5.4-5.25 5.69.42.36.79 1.08.79 2.18v3.23c0 .31.21.67.8.56C20.22 21.38 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
                      </span>
                      <span>GitHub repo</span>
                      <span class="arrow">↗</span>
                    </a>
                  )}
                  {demo && (
                    <a class="pd-meta-link" href={demo} target="_blank" rel="noopener">
                      <span class="icon-svg" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
                      </span>
                      <span>Live site</span>
                      <span class="arrow">↗</span>
                    </a>
                  )}
                </div>
              </div>
            )}
          </aside>
        </div>

      </div>
    </div>

    <Footer />
  </body>
</html>
