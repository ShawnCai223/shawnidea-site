---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<html lang="en">
  <head>
    <BaseHead title="Projects — Shawn Cai" description="A small catalogue of things I've built, broken, and learned from." />
  </head>
  <body>
    <Header />

    <div class="page">
      <div class="container">
        <div class="page-hero">
          <span class="eyebrow accent">Work · 2024 — present</span>
          <h1>Selected work.</h1>
          <p class="lead">A small catalogue of things I've built, broken, and learned from. </p>
        </div>

        <div class="projects-grid">

          <a class="project-tile" href="/projects/ai-blog-generator">
            <div class="project-tile-thumb t-orange">
              <span class="tile-mark">Web app</span>
              <span class="tile-glyph">AI</span>
            </div>
            <h3>AI Blog Generator <span class="year">2025</span></h3>
            <p>A simplified AI-powered content generator. Type a topic, pick a tone, get a structured article from OpenAI.</p>
            <div class="project-tile-bottom">
              <div class="chips">
                <span class="chip accent">Python</span>
                <span class="chip">Flask</span>
                <span class="chip">OpenAI</span>
              </div>
              <span class="read-more">Read case <span>›</span></span>
            </div>
          </a>

          <a class="project-tile" href="/projects/fyyur">
            <div class="project-tile-thumb t-gray">
              <span class="tile-mark">Full stack</span>
              <span class="tile-glyph">Fy</span>
            </div>
            <h3>Fyyur <span class="year">2026</span></h3>
            <p>Booking platform for local artists & venues. Database modelling, migrations, and server-rendered Flask + SQLAlchemy.</p>
            <div class="project-tile-bottom">
              <div class="chips">
                <span class="chip accent">Python</span>
                <span class="chip">PostgreSQL</span>
                <span class="chip">SQLAlchemy</span>
              </div>
              <span class="read-more">Read case <span>›</span></span>
            </div>
          </a>

          <a class="project-tile" href="/projects/shawnidea">
            <div class="project-tile-thumb t-dark">
              <span class="tile-mark">This site</span>
              <span class="tile-glyph">si</span>
            </div>
            <h3>shawnidea.com <span class="year">2026</span></h3>
            <p>Personal site & blog. Astro static build on AWS EC2 + S3, domain through Cloudflare.</p>
            <div class="project-tile-bottom">
              <div class="chips">
                <span class="chip accent">TypeScript</span>
                <span class="chip">Astro</span>
                <span class="chip">AWS</span>
              </div>
              <span class="read-more">Read case <span>›</span></span>
            </div>
          </a>

          <a class="project-tile" href="/projects">
            <div class="project-tile-thumb">
              <span class="tile-mark">Coming soon</span>
              <span class="tile-glyph">04</span>
            </div>
            <h3>Untitled · 04 <span class="year">2026</span></h3>
            <p>A placeholder for the next project. Replace the slug and the case body when it ships.</p>
            <div class="project-tile-bottom">
              <div class="chips">
                <span class="chip outline">In progress</span>
              </div>
              <span class="read-more">Soon <span>›</span></span>
            </div>
          </a>

        </div>
      </div>
    </div>

    <Footer />
  </body>
</html>
